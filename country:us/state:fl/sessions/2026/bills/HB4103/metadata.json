{
  "legislative_session": "2026",
  "identifier": "HB 4103",
  "title": "Apalachicola Water and Sewer District, Franklin County",
  "from_organization": "~{\"classification\": \"lower\"}",
  "classification": [
    "bill"
  ],
  "subject": [
