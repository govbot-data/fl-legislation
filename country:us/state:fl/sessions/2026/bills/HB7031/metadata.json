  "abstracts": [
    {
      "note": "summary",
      "abstract": "Internal Revenue Code ;  Revises the definition of the term \"Internal Revenue Code\"; conforms provisions to changes made by the act; provides for retroactive application; requires the Department of Revenue to adopt rules; authorizes the department to adopt emergency rules."
    }
