  "legislative_session": "2026",
  "identifier": "HB 1499",
  "title": "Pricing Based on Collection of Consumer Information",
  "from_organization": "~{\"classification\": \"lower\"}",
  "classification": [
    "bill"
  ],
  "subject": [
    "(adopted)"
  ],
  "abstracts": [
    {
      "note": "summary",
      "abstract": "Pricing Based on Collection of Consumer Information;  Declares unlawful any act or practice of surveillance pricing; provides exceptions; requires certain individuals who advertise, promote, label, or publish statement, display, image, offer, or announcement of surveillance pricing to include specified clear & conspicuous disclosure with such statement, display, image, offer, or announcement; provides for penalties; prohibits consumers from waiving certain rights; declaring any such waiver void."
    }
  ],
